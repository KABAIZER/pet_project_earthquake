test_dbt:
  target: dev
  outputs:
    dev: &base
      type: duckdb
      path: dbt_dev.duckdb
      external_root: s3://marts-dev
      threads: 4
      extensions: [httpfs, parquet, postgres]
      settings:
        s3_endpoint: localhost:9000
        s3_access_key_id: <minio_secret>
        s3_secret_access_key: <minio_secret>
        s3_use_ssl: false
        s3_url_style: path
      attach:
        - path: "dbname=postgres user=postgres password=<password> host=localhost port=5432"
          type: postgres
          alias: dwh
    prod:
      <<: *base
      path: dbt_prod.duckdb
      external_root: s3://marts-prod